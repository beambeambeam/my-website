{
  "name": "my-website",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "typescript": "^7.0.2",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "vitest": "5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "staged": "vp staged",
    "prepare": "vp config",
    "dev:portfolio": "vp run --filter portfolio dev",
    "env:generate": "varlock codegen --path ./apps/portfolio/",
    "skills:install": "bunx skills experimental_install -y && rm -rf .claude/skills && mkdir -p .claude && ln -s ../.agents/skills .claude/skills",
    "postinstall": "varlock codegen --path ./apps/portfolio/"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@my-website/config": "workspace:*",
    "@types/node": "^26.4.1",
    "rolldown": "1.2.14",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "varlock": "catalog:",
    "vite": "catalog:",
    "vite-plus": "1.3.0",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "packageManager": "bun@1.4.3"
}
